# No credentials here: Spaces keys come from Buildkite Secrets as AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
bucket = "REPLACE-private-state-bucket"
key    = "buildkite-agent/terraform.tfstate"
region = "us-east-1"
endpoints = {
  s3 = "https://nyc3.digitaloceanspaces.com"
}
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_s3_checksum            = true
use_lockfile                = true
