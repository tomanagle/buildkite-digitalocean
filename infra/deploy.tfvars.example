# Non-secret deployment settings. Copy to deploy.tfvars and commit it.
queue  = "linux-docker"
region = "nyc1"
size   = "s-1vcpu-512mb-10gb"
# Set false after the agent is registered to close port 22 again.
droplet_console = true
apt_versions = {
  agent      = "REPLACE_EXACT_APT_VERSION"
  docker     = "REPLACE_EXACT_APT_VERSION"
  containerd = "REPLACE_EXACT_APT_VERSION"
  buildx     = "REPLACE_EXACT_APT_VERSION"
  compose    = "REPLACE_EXACT_APT_VERSION"
}
